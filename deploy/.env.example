# 운영 서버용: ~/haru/.env 로 복사해서 값 채우기 (chmod 600, git에 올리지 않음)
# 변수 이름은 deploy/docker-compose.yml과 1:1로 맞춰져 있음. 비어 있으면 compose가 실패함.
# 값 뒤에 주석을 붙이지 말 것 (주석은 항상 별도 줄).

# ── DB ──
# 이미 초기화된 pgdata 볼륨이 있으면 처음 만들 때 쓴 값과 같아야 함 (POSTGRES_*는 최초 1회만 적용)
DB_NAME=haru
DB_USER=haru
DB_PASSWORD=

# ── JWT ──
# 서버에서 새로 생성: openssl rand -base64 48
JWT_SECRET=

# ── Google 로그인 ──
# 프론트 GOOGLE_WEB_CLIENT_ID와 같은 값
GOOGLE_CLIENT_ID=

# ── OpenAI ──
OPENAI_API_KEY=

# ── 개인정보 암호화 (AES-GCM, 32바이트 base64) ──
# 한번 정하면 변경 금지 (바꾸면 기존 암호화 데이터를 못 읽음)
ENCRYPTION_SECRET_KEY=

# ── 시드 자동 적재 (기본 true) ──
SEED_AUTOLOAD=true

# ── (선택) 롤백용 이미지 태그. 비우면 latest. 예: 특정 커밋 SHA ──
# APP_TAG=
