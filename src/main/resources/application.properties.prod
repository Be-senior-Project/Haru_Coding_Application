spring.application.name=Haru_Coding_backend

# ── DataSource ──────────────────────────────
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/HaruCoding}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:root1212}
spring.datasource.driver-class-name=org.postgresql.Driver

# ── JPA ─────────────────────────────────────
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ── Google OAuth ─────────────────────────────
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}

# ── JWT ──────────────────────────────────────
jwt.secret=${JWT_SECRET}
jwt.access-token-expiry=3600000
jwt.refresh-token-expiry=604800000

# ── Encryption ───────────────────────────────
encryption.secret-key=${ENCRYPTION_SECRET_KEY}

# ── OpenAI ───────────────────────────────────
openai.api-key=${OPENAI_API_KEY:}