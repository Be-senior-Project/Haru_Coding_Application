# 복사해서 frontend/.env 로 사용 (.env는 git에 올리지 않음)
# .env를 바꾼 뒤에는 캐시를 지우고 Metro를 다시 띄워야 반영됨: npx react-native start --reset-cache

# Google 로그인용 Web Client ID (백엔드 GOOGLE_CLIENT_ID와 같은 값)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# 백엔드 주소 (끝에 / 없이)
# 비워두면: 개발 빌드 → http://10.0.2.2:8080 (에뮬레이터 → 내 PC), 릴리스 APK → https://haru.careerpilot.kr
# 운영 서버로 개발 빌드 테스트: https://haru.careerpilot.kr
# 실기기 + 내 PC 서버:          http://<PC의 LAN IP>:8080
API_BASE_URL=
