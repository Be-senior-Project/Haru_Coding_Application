# 백엔드 로컬 개발용 환경변수 목록. 복사해서 backend/.env 로 쓴다(.env는 git에 올리지 않음).
# - docker compose(로컬): 같은 폴더의 .env를 읽어 컨테이너에 넣는다. 값이 없으면 docker-compose.yml의 기본값을 쓴다.
# - IDE bootRun: spring-dotenv가 backend/.env를 읽는다.
# 서버(운영)용 변수 목록은 deploy/.env.example 참고

# [필수] OpenAI API 키. 없으면 시드 문제 적재(임베딩)와 문제 생성이 실패해 문제 은행이 비어 있게 된다
OPENAI_API_KEY=

# [필수] 개인정보 암호화 키 (AES-GCM, 32바이트 base64). 비어 있으면 서버가 기동되지 않음
# 생성 방법: openssl rand -base64 32
# 한 번 정한 뒤 바꾸면 이미 암호화된 데이터(이메일 등)를 읽을 수 없다
ENCRYPTION_SECRET_KEY=

# JWT 서명 키 (32바이트 이상). 생성 방법: openssl rand -base64 48
# 로컬 docker compose는 비워 두면 개발용 기본값을 쓴다. IDE bootRun은 반드시 지정.
JWT_SECRET=

# 구글 로그인 웹 클라이언트 ID (frontend/.env의 GOOGLE_WEB_CLIENT_ID와 같은 값). 비우면 구글 로그인만 거부된다
GOOGLE_CLIENT_ID=

# all_seeds.json → seed_sets 자동 적재 (true/false, 기본 true)
SEED_AUTOLOAD=true

# [선택] 관리용 API 키. 비우면 /api/problems/generate, 임베딩 일괄 생성 API가 비활성화됨 (앱 기능과는 무관)
# 생성 방법: openssl rand -hex 32 / 호출 시 헤더: X-Admin-Key: <이 값>
ADMIN_API_KEY=

# [선택] 아래 값은 필요할 때만 주석을 풀어 쓴다(빈 값으로 두면 IDE bootRun에서 숫자 변환 오류가 난다)
# 사용자 1명이 하루에 AI로 새로 만들 수 있는 문제 수 (기본 30)
# GENERATION_DAILY_LIMIT=30
# API 포트를 열 주소 (기본 127.0.0.1 = 같은 PC에서만 접속). 실기기에서 같은 PC의 서버에 붙을 때만 0.0.0.0
# API_BIND=0.0.0.0

# ── 로컬 docker compose DB/포트 (아래는 기본값. 바꿀 때만 주석 해제) ──
# DB를 처음 만들 때 이 값으로 정해진다. 이미 만든 DB는 그때 쓴 값을 그대로 넣어야 접속된다
# DB_NAME=HaruCoding
# DB_USER=postgres
# DB_PASSWORD=root1212
# DB_PORT=5433
# API_PORT=8080

# ── 도커 없이 IDE에서 직접 실행할 때만 ──
# DB 접속 주소·계정 (비밀번호는 위 DB_PASSWORD를 같이 쓴다). 예전 이름(Haru_Coding_backend_DATASOURCE_URL 등)도 인식한다
# DB_URL=jdbc:postgresql://localhost:5433/HaruCoding
# DB_USERNAME=postgres
