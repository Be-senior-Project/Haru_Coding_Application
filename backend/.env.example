# 복사해서 backend/.env 로 사용 (.env는 git에 올리지 않음)
# - docker compose(로컬): 같은 폴더의 .env를 읽어 컨테이너에 주입
# - IDE bootRun: spring-dotenv가 backend/.env를 읽음
# 서버(운영)용 변수 목록은 deploy/.env.example 참고

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Encryption Key (AES-GCM, 32 bytes Base64)
# 생성 방법: openssl rand -base64 32
ENCRYPTION_SECRET_KEY=your-32-byte-base64-encoded-key-here

# JWT 서명 키 (32바이트 이상)
# 생성 방법: openssl rand -base64 48
# 로컬 docker compose는 비워두면 개발용 기본값 사용. IDE bootRun은 반드시 지정.
JWT_SECRET=

# Google 로그인 Web Client ID (프론트 GOOGLE_WEB_CLIENT_ID와 같은 값)
# 비워두면 로컬 compose는 더미 값으로 기동됨 (Google 로그인만 안 됨)
GOOGLE_CLIENT_ID=

# all_seeds.json → seed_sets 자동 적재 (true/false, 기본 true)
SEED_AUTOLOAD=true

# ── 로컬 docker compose DB/포트 (아래는 기본값. 바꿀 때만 주석 해제) ──
# DB_NAME=HaruCoding
# DB_USER=postgres
# DB_PASSWORD=root1212
# DB_PORT=5433
# API_PORT=8080
