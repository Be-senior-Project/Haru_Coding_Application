# 백엔드 환경변수 목록. 이 파일은 값 없이 저장소에 두고, 실제 값은 같은 폴더의 .env에 넣는다(.env는 커밋 금지).
# docker compose는 이 폴더의 .env를 읽어 컨테이너에 넘긴다.

# [필수] OpenAI API 키. 없으면 시드 문제 적재(임베딩)와 문제 생성이 실패해 문제 은행이 비어 있게 된다
OPENAI_API_KEY=

# [필수] 개인정보 암호화 키 (AES-GCM, 32바이트 base64). 비어 있으면 서버가 기동되지 않음
# 생성 방법: openssl rand -base64 32
# 한 번 정한 뒤 바꾸면 이미 암호화된 데이터(이메일 등)를 읽을 수 없다
ENCRYPTION_SECRET_KEY=

# [필수] JWT 서명 키 (32바이트 이상). 비어 있으면 서버가 기동되지 않음
# 생성 방법: openssl rand -base64 48
JWT_SECRET=

# [필수] DB 비밀번호. docker compose가 DB 컨테이너와 서버에 같이 넘긴다. 비어 있으면 compose가 실행되지 않음
# 생성 방법: openssl rand -hex 24
# DB를 처음 만들 때 이 값으로 정해진다. 이미 만든 DB(로컬 포함)는 그때 쓴 비밀번호를 그대로 넣어야 접속된다
DB_PASSWORD=

# [구글 로그인을 쓰면 필수] 앱의 웹 클라이언트 ID (frontend/.env의 GOOGLE_WEB_CLIENT_ID와 같은 값). 비우면 구글 로그인 거부
GOOGLE_CLIENT_ID=

# [선택] 관리용 API 키. 비우면 /api/problems/generate, 임베딩 일괄 생성 API가 비활성화됨 (앱 기능과는 무관)
# 생성 방법: openssl rand -hex 32 / 호출 시 헤더: X-Admin-Key: <이 값>
ADMIN_API_KEY=

# [선택] 사용자 1명이 하루에 AI로 새로 만들 수 있는 문제 수. 비우면 30
GENERATION_DAILY_LIMIT=

# [선택] API 포트를 열 주소. 비우면 127.0.0.1(서버 안에서만 접속, 외부 요청은 Caddy 등 앞단 프록시가 받아 넘김)
# 실기기에서 같은 PC의 서버에 붙을 때만 0.0.0.0
API_BIND=

# [도커 없이 서버를 직접 실행할 때만] DB 접속 주소·계정. 도커로 실행하면 docker-compose.yml 값이 쓰인다
# 예: DB_URL=jdbc:postgresql://localhost:5433/HaruCoding, DB_USERNAME=postgres
# 예전 이름(Haru_Coding_backend_DATASOURCE_URL 등)도 계속 인식함
DB_URL=
DB_USERNAME=
