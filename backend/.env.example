# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Encryption Key (AES-GCM, 32 bytes Base64)
# 생성 방법: openssl rand -base64 32
ENCRYPTION_SECRET_KEY=your-32-byte-base64-encoded-key-here

# JWT 서명 키 (필수, 32바이트 이상). 비어 있으면 서버가 기동되지 않음
# 생성 방법: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# (선택) 관리용 API 키. 비우면 /api/problems/generate, 임베딩 일괄 생성 API가 비활성화됨
# 호출 시 헤더: X-Admin-Key: <이 값>
ADMIN_API_KEY=

# (선택) 사용자 1명이 하루에 AI로 새로 만들 수 있는 문제 수 (기본 30)
GENERATION_DAILY_LIMIT=30
