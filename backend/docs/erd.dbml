// 하루코딩 ERD (2026-11-23, backend/init.sql + 엔티티 기준)
// dbdiagram.io에 그대로 붙여 넣어 쓴다.

Table users {
  id bigserial [pk]
  google_id varchar(255) [unique]
  email text [not null]
  email_hash varchar(255) [not null, unique]
  password varchar(255)
  nickname varchar(100) [not null]
  profile_image_url text
  level int [not null, default: 1]
  xp int [not null, default: 0]
  streak_days int [not null, default: 0]
  preferred_language varchar(20) [note: '허용값: preferred_language IN (JAVA,PYTHON,C,JS)']
  coding_level varchar(10) [not null, default: 'NONE', note: '허용값: coding_level IN (NONE, SOME, LOTS)']
  cote_prepared boolean [not null, default: false]
  recommended_difficulty varchar(10)
  daily_goal_count int [not null, default: 3, note: '허용값: daily_goal_count BETWEEN 1 AND 10']
  difficulty_level varchar(2) [note: '허용값: difficulty_level IN (L1,L2,L3,L4,L5)']
  fcm_token text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '회원. 이메일은 AES-GCM 암호화 + 검색용 해시'
}

Table refresh_tokens {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  token text [not null, unique]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]

  Note: '리프레시 토큰(로그아웃 시 삭제)'
}

Table topics {
  id bigserial [pk]
  name varchar(100) [not null, unique]
  description text
  icon varchar(100)

  Note: '학습 주제 = 문제 분류 3개. 서버 시작 시 준비(TopicInitializer)'
}

Table problems {
  id bigserial [pk]
  set_id varchar(50)
  type varchar(30) [not null, note: '허용값: type IN (IMPLEMENTATION,DEBUGGING,FILL_IN_THE_BLANK)']
  category varchar(100) [not null]
  subcategory varchar(100)
  difficulty int [not null, note: '허용값: difficulty IN (0,1,2)']
  language varchar(20) [not null, note: '허용값: language IN (Python,Java,C++)']
  title varchar(255) [not null]
  description text [not null]
  io_example jsonb
  code_skeleton text
  answer jsonb [not null]
  explanation text [not null]
  concept_explanation text
  hidden_tests jsonb
  created_at timestamp [not null, default: `now()`]
  constraints jsonb [note: '엔티티에서 추가(ddl-auto)']
  hint1 text [note: '힌트 1(방향)']
  hint2 text [note: '힌트 2(구체적)']
  hint3 text [note: '힌트 3(코드 구조)']

  indexes {
    difficulty
    category
    set_id
  }

  Note: '문제(시드 + AI 생성). 정답·숨겨진 테스트는 응답에 포함하지 않음'
}

Table problem_embeddings {
  problem_id bigint [pk, ref: - problems.id, note: '삭제 시 함께 삭제']
  embedding "vector(1536)" [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    embedding [note: 'HNSW 벡터 인덱스(유사도 검색)']
  }

  Note: '추천용 벡터(pgvector, text-embedding-3-small)'
}

Table problem_sets {
  id bigserial [pk]
  title varchar(255) [not null]
  target_date date [not null, unique]
  difficulty varchar(10) [not null, default: '초급']
  is_ai_generated boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Note: '공통 세트(현재 앱은 사용하지 않는 /api/problem-sets용)'
}

Table problem_set_items {
  id bigserial [pk]
  problem_set_id bigint [not null, ref: > problem_sets.id, note: '삭제 시 함께 삭제']
  problem_id bigint [not null, ref: > problems.id]
  sort_order int [not null, default: 0]

  indexes {
    (problem_set_id, problem_id) [unique]
  }

  Note: '공통 세트에 들어간 문제'
}

Table user_problem_records {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  problem_id bigint [not null, ref: > problems.id]
  is_correct boolean [not null]
  user_answer jsonb
  time_spent_sec int
  xp_earned int [not null, default: 0]
  solved_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    problem_id
  }

  Note: '풀이 기록(모든 제출). 통계·약점은 문제별 첫 제출 기준으로 계산'
}

Table user_streak_logs {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  streak_date date [not null]
  streak_count int [not null, default: 1]

  indexes {
    (user_id, streak_date) [unique]
    user_id
  }

  Note: '날짜별 연속 학습 이력'
}

Table user_category_stats {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  topic_id bigint [not null, ref: > topics.id]
  total_solved int [not null, default: 0]
  correct_count int [not null, default: 0]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, topic_id) [unique]
  }

  Note: '분류별 누적(제출 시 갱신). 화면 통계는 풀이 기록에서 계산'
}

Table user_xp_logs {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  xp_amount int [not null]
  reason varchar(30) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: 'XP 적립 이력'
}

Table user_leagues {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  tier varchar(20) [not null, default: 'BRONZE']
  score int [not null, default: 0]
  season int [not null]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, season) [unique]
  }

  Note: '리그(티어·점수)'
}

Table problem_scraps {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  problem_id bigint [not null, ref: > problems.id, note: '삭제 시 함께 삭제']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, problem_id) [unique]
    user_id
  }

  Note: '스크랩한 문제'
}

Table notifications {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id, note: '삭제 시 함께 삭제']
  title varchar(100) [not null]
  body text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: '알림'
}

Table seed_sets {
  id bigserial [pk]
  category varchar(255) [not null]
  subcategory varchar(255)
  difficulty int [not null]
  language varchar(255) [not null]
  concept_explanation text
  problems jsonb
  embedding "vector(1536)"

  indexes {
    (category, language, difficulty)
    embedding [note: 'HNSW 벡터 인덱스(유사도 검색)']
  }

  Note: '시드 세트 원본(문제 생성 시 예시로 사용)'
}
